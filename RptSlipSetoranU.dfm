  object Qry: TADOQuery
    Connection = Main.MyConnection
    Parameters = <>
    SQL.Strings = (
      'SELECT a.*,b.name,b.details FROM wh_vhc_trans_detail AS a '#39'+'
      
        '        '#39' INNER JOIN wh_transaction_type AS b ON b.transaction_t' +
        'ype_id=a.transaction_type_id '#39'+'
      
        '        '#39' WHERE vhc_trans_id='#39'+Chr(39)+TransId+Chr(39)+'#39' AND ((b' +
        '.transaction_obj_id=2) OR (b.transaction_obj_id=3));'#39';')
    Left = 21
    Top = 16
  end
end
