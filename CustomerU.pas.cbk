procedure TCustomer.CreditLimitEnter(Sender: TObject);
begin
  if CreditLimit.Text<>'' then CreditLimit.Text:=ToString(CreditLimit.Text);
end;

procedure TCustomer.CreditLimitExit(Sender: TObject);
begin
  if CreditLimit.Text<>'' then CreditLimit.Text:=SToCurr(CreditLimit.Text);
end;

procedure TCustomer.StrGridDblClick(Sender: TObject);
begin
  if FormRequest='' then begin
//    if Main.IsFormOpen('OfferingForm')=False then OfferingForm:=TOfferingForm.Create(Self,StrGrid.Cells[0,IntRow],False)
  end else begin
    if (UpperCase(FormRequest)='OFFERING-CREATE') and (StrGrid.Cells[9,IntRow]<>'') then  begin
      OfferingForm.SetContactId(StrGrid.Cells[9,IntRow]);
      Close;
    end;
    if (UpperCase(FormRequest)='ORDER-CREATE') and (StrGrid.Cells[9,IntRow]<>'') then  begin
      OrderForm.SetContactId(StrGrid.Cells[9,IntRow]);
      Close;
    end;
    if (UpperCase(FormRequest)='CONTRACT-CREATE') and (StrGrid.Cells[9,IntRow]<>'') then  begin
      Contract.SetContactId(StrGrid.Cells[9,IntRow]);
      Close;
    end;
  end;
end;

