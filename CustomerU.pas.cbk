procedure TCustomer.ContactNameKeyPress(Sender: TObject; var Key: Char);
begin
  if Key=#13 then begin
    if Trim(ContactName.Text)<>'' then
      if StrGrid.RowCount-1<=StrGrid.Row then StrGrid.RowCount:=StrGrid.RowCount+1;
    ContactNameExit(nil);
  end;
end;

