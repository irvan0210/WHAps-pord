unit VehicleInsuranceU;

interface

uses
  Windows, Messages, SysUtils, Variants, Classes, Graphics, Controls, Forms,
  Dialogs, StdCtrls, Grids, ZColorStringGrid, WHUnit, ADODB, ComCtrls,
  ExtCtrls, Menus;

type
  TVehicleInsurance = class(TForm)
    GroupInput: TGroupBox;
    Simpan: TButton;
    Bersihkan: TButton;
    Selesai: TButton;
    GroupPanel: TPanel;
    Label1: TLabel;
    Label4: TLabel;
    Label13: TLabel;
    Label16: TLabel;
    Label21: TLabel;
    Label11: TLabel;
    Label17: TLabel;
    Label32: TLabel;
    Label18: TLabel;
    Label2: TLabel;
    Label5: TLabel;
    Label6: TLabel;
    SBU: TComboBox;
    NoPolis: TEdit;
    NilaiPolis: TEdit;
    Cari: TEdit;
    StrGrid: TZColorStringGrid;
    StrGridVhcList: TZColorStringGrid;
    GroupBox1: TGroupBox;
    Label3: TLabel;
    Total: TEdit;
    fromDate: TDateTimePicker;
    toDate: TDateTimePicker;
    eInsIssuer: TComboBox;
    PopupMenu1: TPopupMenu;
    HapusData1: TMenuItem;
    Label7: TLabel;
    Label8: TLabel;
    eInsCoverage: TComboBox;
    Label9: TLabel;
    Label10: TLabel;
    eInsName: TComboBox;
    edt1: TEdit;
    procedure FormShow(Sender: TObject);
    procedure CariChange(Sender: TObject);
    procedure SelesaiClick(Sender: TObject);
    procedure FormClose(Sender: TObject; var Action: TCloseAction);
    procedure StrGridSelectCell(Sender: TObject; ACol, ARow: Integer;
      var CanSelect: Boolean);
    procedure StrGridVhcListSelectCell(Sender: TObject; ACol,
      ARow: Integer; var CanSelect: Boolean);
    procedure StrGridDblClick(Sender: TObject);
    procedure BersihkanClick(Sender: TObject);
    procedure SimpanClick(Sender: TObject);
    procedure NilaiPolisEnter(Sender: TObject);
    procedure NilaiPolisExit(Sender: TObject);
    procedure NilaiPolisKeyPress(Sender: TObject; var Key: Char);
    procedure NoPolisKeyPress(Sender: TObject; var Key: Char);
    procedure PenerbitPolisKeyPress(Sender: TObject; var Key: Char);
    procedure HapusData1Click(Sender: TObject);
  private
    { Private declarations }
    VehicleArr:Array of TArrString22;
    CompanyArr:Array of TArrString5;
    VhcInsArr, InsIssuerArr, InsNameArr, InsCoverageArr:Array of TArrString4;
    FormRequest:String;
    IsReadOnly:Boolean;
    SelectedRow : Integer;
    IntRow, IntRowA, IntCol, IntColA : Integer;
    procedure Init;
    procedure RefreshCombo;
    procedure RefreshList;
    procedure RefreshArray;
    procedure DisableInput;
    procedure EnableInput;
    procedure LoadData;

  public
    { Public declarations }
    VhcType:Integer;
    VhcInsId:String;
    constructor Create(AOwner:TComponent;VehicleType:String;VhcIns_Id:String='';Form_Request:String='';Is_ReadOnly:Boolean=True);Overload;
  end;

var
  VehicleInsurance: TVehicleInsurance;

const
  MaxCol = 5;

implementation

uses MainU, Math, DB;

{$R *.dfm}

constructor TVehicleInsurance.Create(AOwner:TComponent;VehicleType:String;VhcIns_Id:String='';Form_Request:String='';Is_ReadOnly:Boolean=True);
begin
  if UpperCase(VehicleType)='BUS' then begin
    VhcType:=2;
//    VhcCompanyId:=2;
  end else if UpperCase(VehicleType)='GRAYLINE' then begin
    VhcType:=3;
//    VhcCompanyId:=7;
  end else begin
    if (CompanyId='2') or (CompanyId='9') or (CompanyId='11') then begin
      VhcType:=2;
    end else if (CompanyId='3') then begin
      VhcType:=1;
    end;
  //  VhcCompanyId:=StrToInt(CompanyId);
  end;
  FormRequest:=Form_Request;
  VhcInsId := VhcIns_Id;
  IsReadOnly:=Is_ReadOnly;
  Main.WriteLog('Form Open: VehicleInsurance='+VehicleType+',FormRequest='+Form_Request,1);
  inherited Create(AOwner);
end;

procedure TVehicleInsurance.Init;
var IntCount:Integer;
begin
  fromDate.Date := Now;
  toDate.Date := Now;

  StrGrid.ColCount:=MaxCol;
  SelectedRow:=0;
  StrGrid.RowCount:=2;
  StrGrid.ColWidths[0]:=1;
  StrGrid.Cells[0,0]:='Id';
  StrGrid.Cells[1,0]:='Lokasi';
  StrGrid.Cells[2,0]:='No Bodi';
  StrGrid.Cells[3,0]:='No Polisi';
  StrGrid.Cells[4,0]:='Tahun';

  StrGrid.ColWidths[0]:=0;
  StrGrid.ColWidths[1]:=80;
  StrGrid.ColWidths[2]:=100;
  StrGrid.ColWidths[3]:=105;
  StrGrid.ColWidths[4]:=50;

  StrGridVhcList.Cells[0,0]:='Vehicle Id';
  StrGridVhcList.Cells[1,0]:='No Polisi';
  StrGridVhcList.Cells[2,0]:='Nilai Pertanggungan';
  StrGridVhcList.ColWidths[0]:=0;
  StrGridVhcList.ColWidths[1]:=80;
  StrGridVhcList.ColWidths[2]:=120;

  for IntCount:=0 to MaxCol-1 do
    StrGrid.Cells[IntCount,1]:='';

  if StrToInt(CompanyId)=1 then SBU.Enabled:=True else SBU.Enabled:=False;
end;


procedure TVehicleInsurance.LoadData;
var Qry:TADOQuery;
    StrQry:String;
    IntCount,IntDiscount:Integer;
begin
  Qry:=TADOQuery.Create(Self);
  Qry.Connection:=Main.MyConnection;
  Main.M_Busy;
  if Main.OpenDb then begin
    StrQry:='EXEC GetInsuranceDetail '+QuotedStr(VhcInsId)+';';
    Qry.SQL.Clear;
    Main.WriteLog('SQL :'+StrQry,2);
    Qry.SQL.Add(StrQry);
    Qry.Open;
    IntCount:=0;
    //StrGridVhcList.RowCount := Qry.RecordCount + 1;
    if Qry.RecordCount>0 then while not(Qry.Eof) do begin
      //OrderId.Text:=Qry.FieldValues['vhc_insurance_id'];
      if Qry.FieldValues['insurance_number']<>NULL then NoPolis.Text:=Qry.FieldValues['insurance_number'];
      NilaiPolis.Text:=Qry.FieldValues['insurance_amount'];
      fromDate.Date:=Qry.FieldValues['insurance_from_date'];
      toDate.Date:=Qry.FieldValues['insurance_to_date'];

      eInsIssuer.ItemIndex := eInsIssuer.Items.IndexOf(Qry.FieldValues['insurance_name']);

      eInsName.ItemIndex := eInsName.Items.IndexOf(Qry.FieldValues['insurance_names']);
      eInsCoverage.ItemIndex := eInsCoverage.Items.IndexOf(Qry.FieldValues['insurance_coverage']);

      SetLength(VhcInsArr, length(VhcInsArr)+1);
      if length(VhcInsArr)>1 then
        StrGridVhcList.RowCount := StrGridVhcList.RowCount + 1;

      VhcInsArr[length(VhcInsArr)-1][0]:= Qry.FieldValues['vehicle_id'];
      VhcInsArr[length(VhcInsArr)-1][1]:= LicensePlate(Qry.FieldValues['license_plate']);
      VhcInsArr[length(VhcInsArr)-1][2]:= Qry.FieldValues['amount'];

//      StrGridVhcList.Cells[0, IntCount+1] := Qry.FieldValues['vehicle_id'];
//      StrGridVhcList.Cells[1, IntCount+1] := LicensePlate(Qry.FieldValues['license_plate']);
//      StrGridVhcList.Cells[2, IntCount+1] := SToCurr(Qry.FieldValues['amount']);

      Qry.Next;
      Inc(IntCount)
    end;

      for IntCount:=0 to Length(VhcInsArr)-1 do begin
        StrGridVhcList.Cells[0, IntCount+1] := VhcInsArr[IntCount][0];
        StrGridVhcList.Cells[1, IntCount+1] := VhcInsArr[IntCount][1];
        StrGridVhcList.Cells[2, IntCount+1] := SToCurr(VhcInsArr[IntCount][2]);
      end;

    Qry.Close;
  end;
  FreeAndNil(Qry);
  Main.CloseDb;
  Main.M_Normal;
end;

procedure TVehicleInsurance.RefreshCombo;
var Qry:TADOQuery;
    StrQry:String;
    IntCount:Integer;
begin
  Qry:=TADOQuery.Create(Self);
  Qry.Connection:=Main.MyConnection;
  if Main.OpenDb then begin

    eInsIssuer.Items.Clear;
    eInsIssuer.Text:='';
    StrQry:='';
    SetLength(InsIssuerArr,0);
    StrQry:='EXEC GetInsuranceIssuer;';
    Main.WriteLog('SQL :'+StrQry,2);
    Qry.SQL.Add(StrQry);
    Qry.Close;
    Qry.Prepared:=false;
    Qry.Open;
    IntCount:=0;
    SetLength(InsIssuerArr,Qry.RecordCount);
    if Qry.RecordCount>0 then begin
      while not(Qry.Eof) do begin
        InsIssuerArr[IntCount][0]:=Qry.FieldValues['insurance_issuer_id'];
        InsIssuerArr[IntCount][1]:=Qry.FieldValues['name'];
        Qry.Next;
        Inc(IntCount)
      end;
    end;
    Qry.Close;

    for IntCount:=0 to Length(InsIssuerArr)-1 do
      eInsIssuer.Items.Add(InsIssuerArr[IntCount][1]);

    //Name
    eInsName.Items.Clear;
    eInsName.Text:='';
    StrQry:='';
    SetLength(InsNameArr,0);
    StrQry:='EXEC GetInsuranceName;';
    Main.WriteLog('SQL :'+StrQry,2);
    Qry.SQL.Clear;
    Qry.SQL.Add(StrQry);
    Qry.Close;
    Qry.Prepared:=false;
    Qry.Open;
    IntCount:=0;
    SetLength(InsNameArr,Qry.RecordCount);
    if Qry.RecordCount>0 then begin
      while not(Qry.Eof) do begin
        InsNameArr[IntCount][0]:=Qry.FieldValues['insurance_name_id'];
        InsNameArr[IntCount][1]:=Qry.FieldValues['name'];
        Qry.Next;
        Inc(IntCount)
      end;
    end;
    Qry.Close;

    for IntCount:=0 to Length(InsNameArr)-1 do
      eInsName.Items.Add(InsNameArr[IntCount][1]);

    //Coverage
    eInsCoverage.Items.Clear;
    eInsCoverage.Text:='';
    StrQry:='';
    SetLength(InsCoverageArr,0);
    StrQry:='EXEC GetInsuranceCoverage;';
    Main.WriteLog('SQL :'+StrQry,2);
    Qry.SQL.Clear;
    Qry.SQL.Add(StrQry);
    Qry.Close;
    Qry.Prepared:=false;
    Qry.Open;
    IntCount:=0;
    SetLength(InsCoverageArr,Qry.RecordCount);
    if Qry.RecordCount>0 then begin
      while not(Qry.Eof) do begin
        InsCoverageArr[IntCount][0]:=Qry.FieldValues['insurance_coverage_id'];
        InsCoverageArr[IntCount][1]:=Qry.FieldValues['name'];
        Qry.Next;
        Inc(IntCount)
      end;
    end;
    Qry.Close;

    for IntCount:=0 to Length(InsCoverageArr)-1 do
      eInsCoverage.Items.Add(InsCoverageArr[IntCount][1]);
      
    FreeAndNil(Qry);

    Qry:=TADOQuery.Create(Self);
    Qry.Connection:=Main.MyConnection;
    SetLength(CompanyArr,0);
    StrQry:='EXEC GetCompanyLocationList';
    Main.WriteLog('SQL :'+StrQry,2);
    Qry.SQL.Add(StrQry);
    Qry.Open;
    IntCount:=0;
    SetLength(CompanyArr,Qry.RecordCount);
    if Qry.RecordCount>0 then begin
      while not(Qry.Eof) do begin
        CompanyArr[IntCount][0]:=Qry.FieldValues['company_location_id'];
        CompanyArr[IntCount][1]:=Qry.FieldValues['company_id'];
        CompanyArr[IntCount][2]:=Qry.FieldValues['location_id'];
        CompanyArr[IntCount][3]:=Qry.FieldValues['name'];
        CompanyArr[IntCount][4]:=Qry.FieldValues['location'];
        CompanyArr[IntCount][5]:=Qry.FieldValues['company_code'];
        Qry.Next;
        Inc(IntCount)
      end;
    end;
    Qry.Close;

  end;
  FreeAndNil(Qry);
  Main.CloseDb;
  for IntCount:=0 to Length(CompanyArr)-1  do begin
    SBU.Items.Add(CompanyArr[IntCount][3]+' ('+CompanyArr[IntCount][4]+')');
    if (CompanyId=CompanyArr[IntCount][1]) and  (LocationId=CompanyArr[IntCount][2]) then SBU.ItemIndex:=IntCount;
  end;

end;

procedure TVehicleInsurance.RefreshList;
var Count,Count2:Integer;
    StrQry,Str,StrLocation,StrGroup,StrCompany,StrOrderBy:String;
    QVhc:TADOQuery;
begin
  Main.M_Busy;
  For Count:=0 to Length(VehicleArr)-1 do begin
    for Count2:=0 to 12 do
    StrGrid.Cells[Count2,Count+1]:='';
  end;
  SetLength(VehicleArr,0);
  StrLocation:=CompanyArr[SBU.ItemIndex][2];
  StrCompany:='@CompanyId='+CompanyArr[SBU.ItemIndex][1];

  QVhc:=TADOQuery.Create(Self);
  QVhc.Connection:=Main.MyConnection;
  if Main.OpenDb then begin
    StrQry:='EXEC GetVhcList '+StrLocation+',0,'+StrCompany+';';
    Main.WriteLog('SQL :'+StrQry,2);
    QVhc.SQL.Add(StrQry);
    QVhc.Open;
    Count:=0;
    if (QVhc.RecordCount>0) then while not(QVhc.Eof) do begin
      SetLength(VehicleArr,Count+1);
        VehicleArr[Count][0]:=QVhc.FieldValues['vehicle_id'];
        VehicleArr[Count][1]:=QVhc.FieldValues['location'];
        VehicleArr[Count][2]:=QVhc.FieldValues['body_id'];

        if IsCharAlpha(PChar(Copy(QVhc.FieldValues['license_plate'],2,1))^)=False then
          VehicleArr[Count][3]:=Copy(QVhc.FieldValues['license_plate'],1,1)+' '+Copy(QVhc.FieldValues['license_plate'],2,4)+
                              ' '+Copy(QVhc.FieldValues['license_plate'],6,Length(QVhc.FieldValues['license_plate'])+1)
        else
          VehicleArr[Count][3]:=Copy(QVhc.FieldValues['license_plate'],1,2)+' '+Copy(QVhc.FieldValues['license_plate'],3,4)+
                              ' '+Copy(QVhc.FieldValues['license_plate'],7,Length(QVhc.FieldValues['license_plate'])+1);

        if QVhc.FieldValues['year']<>NULL then
          VehicleArr[Count][4]:=QVhc.FieldValues['year'];
//        VehicleArr[Count][7]:=QVhc.FieldValues['vhc_batch_id'];

        QVhc.Next;
        Inc(Count);
    end;
    QVhc.Close;
  end;
  Main.CloseDb;
  QVhc.Destroy;
  if Length(VehicleArr)>0 then StrGrid.RowCount:=Length(VehicleArr)+1
  else StrGrid.RowCount:=2;

  For Count:=0 to Length(VehicleArr)-1 do begin
    for Count2:=0 to 21 do
    StrGrid.Cells[Count2,Count+1]:=VehicleArr[Count][Count2];
  end;

  Total.Text:=IntToStr(Length(VehicleArr));
  Main.M_Normal;
end;

procedure TVehicleInsurance.RefreshArray;
var
  IntCount : Byte;
begin
      SetLength(VhcInsArr, StrGridVhcList.RowCount-1);
      if (Length(VhcInsArr)>1) then begin
        for IntCount:=0 to Length(VhcInsArr)-1 do begin
          VhcInsArr[IntCount][0] := StrGridVhcList.Cells[0, IntCount+1];
          VhcInsArr[IntCount][1] := StrGridVhcList.Cells[1, IntCount+1];
          VhcInsArr[IntCount][2] := ToString(StrGridVhcList.Cells[2, IntCount+1]);
        end;
      end;
      if StrGridVhcList.RowCount=1 then begin
        StrGridVhcList.RowCount := 2;
        for IntCount:=1 to StrGridVhcList.RowCount-1 do begin
          StrGridVhcList.Cells[0, IntCount] :='';
          StrGridVhcList.Cells[1, IntCount] :='';
          StrGridVhcList.Cells[2, IntCount] :='';
        end;
      end;
end;

procedure TVehicleInsurance.EnableInput;
begin
  Simpan.Enabled:=True;
  GroupPanel.Enabled:=True;
end;

procedure TVehicleInsurance.DisableInput;
begin
  Simpan.Enabled:=False;
  GroupPanel.Enabled:=False;
end;


procedure TVehicleInsurance.FormShow(Sender: TObject);
begin
  Init;
  RefreshCombo;
  RefreshList;
  if VhcInsId<>'' then begin
    LoadData;
  end;
  
  if IsReadOnly then
    DisableInput
  else EnableInput;
end;

procedure TVehicleInsurance.CariChange(Sender: TObject);
var Count,Count2,Count3,Count4:Integer;
    IsTrue:Boolean;
begin
  if Trim(Cari.Text)<>'' then begin
    Init;
    Count2:=2;
    for Count:=0 to Length(VehicleArr)-1 do begin
      IsTrue:=False;
      for Count3:=0 to 21 do
      if (StrPos(PChar(UpperCase(VehicleArr[Count][Count3])),PChar(UpperCase(Cari.Text)))<>nil) then IsTrue:=True;
      if IsTrue then begin
          StrGrid.RowCount:=Count2;
          for Count4:=0 to 21 do
          StrGrid.Cells[Count4,Count2-1]:=VehicleArr[Count][Count4];
          Inc(Count2);
      end;
    end;
    Total.Text:=IntToStr(Count2-2);
  end else
    RefreshList;
end;

procedure TVehicleInsurance.SelesaiClick(Sender: TObject);
begin
    Close;
end;

procedure TVehicleInsurance.FormClose(Sender: TObject;
  var Action: TCloseAction);
begin
    Action := caFree;
end;

procedure TVehicleInsurance.StrGridSelectCell(Sender: TObject; ACol,
  ARow: Integer; var CanSelect: Boolean);
begin
  IntRow:=ARow;
  IntCol:=ACol;
end;

procedure TVehicleInsurance.StrGridVhcListSelectCell(Sender: TObject; ACol,
  ARow: Integer; var CanSelect: Boolean);
begin
  IntRowA:=ARow;
  IntColA:=ACol;
end;

procedure TVehicleInsurance.StrGridDblClick(Sender: TObject);
var
  IntAmount, IntCount : Integer;
  StrAmount : String;
  StrList:TStringList;
  isFound : Boolean;
begin
  StrAmount := InputBox('Nominal asuransi', 'Masukkan nilai asuransi untuk kendaraan ini : ', '');
  if (StrAmount<>'') then begin
    isFound := False;

    for IntCount:=0 to Length(VhcInsArr)-1 do begin
      if VhcInsArr[IntCount][0] = StrGrid.Cells[0,IntRow] then
        isFound := True;
    end;

    if not isFound then begin
      SetLength(VhcInsArr, length(VhcInsArr)+1);
      if length(VhcInsArr)>1 then
        StrGridVhcList.RowCount := StrGridVhcList.RowCount + 1;

      VhcInsArr[length(VhcInsArr)-1][0]:= StrGrid.Cells[0,IntRow];
      VhcInsArr[length(VhcInsArr)-1][1]:= StrGrid.Cells[3,IntRow];
      VhcInsArr[length(VhcInsArr)-1][2]:= StrAmount;
      for IntCount:=0 to Length(VhcInsArr)-1 do begin
        StrGridVhcList.Cells[0, IntCount+1] := VhcInsArr[IntCount][0];
        StrGridVhcList.Cells[1, IntCount+1] := VhcInsArr[IntCount][1];
        StrGridVhcList.Cells[2, IntCount+1] := SToCurr(VhcInsArr[IntCount][2]);
      end;
    end else begin
      MessageDlg('No Kendaraan tersebut sudah diinput !!!', mtWarning, [mbOK], 0);
    end;

  end else begin
      //ShowMessage('Masih kosong');
  end;

end;

procedure TVehicleInsurance.BersihkanClick(Sender: TObject);
var
  intCount : Byte;
begin
    SetLength(VhcInsArr, 0);
    NoPolis.Clear;
    eInsIssuer.ItemIndex := -1;
    eInsName.ItemIndex := -1;
    eInsCoverage.ItemIndex := -1;
    NilaiPolis.Text := '0';
    for intCount:=1 to StrGridVhcList.RowCount do begin
      StrGridVhcList.Cells[0, intCount] := '';
      StrGridVhcList.Cells[1, intCount] := '';
      StrGridVhcList.Cells[2, intCount] := '';
    end;
    StrGridVhcList.RowCount := 2;
    EnableInput;
end;

procedure ribuan(edit : Tedit);
var
  sRupiah: string;
  iRupiah: Currency;
begin
  //ribuan --> currency ( menyesuaikan setting windows )
  sRupiah := edit.Text;
  sRupiah := StringReplace(sRupiah,',','',[rfReplaceAll,rfIgnoreCase]); // hilangkan char koma , pemisah //ribuan selain IDR
  sRupiah := StringReplace(sRupiah,'.','',[rfReplaceAll,rfIgnoreCase]); //remove char titik .    pemisah //ribuan IDR
  iRupiah := StrToCurrDef(sRupiah,0); // convert srupiah ke currency

  //currency --> format ribuan
  edit.Text := FormatCurr('#,###',iRupiah);
  edit.SelStart := length(edit.text);
end;

function hapusribuan(edit : Tedit): string;
var hasil : string;
begin
  hasil := edit.text;
  hasil := StringReplace(hasil,',','',[rfReplaceAll,rfIgnoreCase]);
  hasil := StringReplace(hasil,'.','',[rfReplaceAll,rfIgnoreCase]);
  hapusribuan := hasil;
end;

procedure TVehicleInsurance.SimpanClick(Sender: TObject);
var Qry:TADOQuery;
    StrQry,StrMaxId,StrActive,StrEMsg,
    StrDateFrom,StrDateTo,StrDateBefore,
    StrVhcTransId,StrCustomerOrder,StrInsIssuer, StrInsName, StrInsCoverage:String;
    IsOk:Boolean;
    IntCount:Byte;
    IntTotal : Integer;
    VhcTransIdArr, CustomerOrderArr:Array of TArrString1;
begin
  edt1.Text:=hapusribuan(NilaiPolis)            ;
  if (
      (Trim(NoPolis.Text)<>'') OR (eInsIssuer.ItemIndex<>-1) or (Trim(NilaiPolis.Text)<>'')
      ) then begin
    Qry:=TADOQuery.Create(Self);
    Qry.Connection:=Main.MyConnection;
    IsOk:=True;
    IntTotal:=0;
    if Length(VhcInsArr)>=1 then begin
      for IntCount:=0 to Length(VhcInsArr)-1 do 
        IntTotal := IntTotal + StrToInt(VhcInsArr[IntCount][2]);
    end;

    Try
      StrInsIssuer:=InsIssuerArr[eInsIssuer.ItemIndex][0];
    Except
      on exception do
        StrInsIssuer:='';
    End;

    Try
      StrInsName:=InsNameArr[eInsName.ItemIndex][0];
    Except
      on exception do
        StrInsName:='';
    End;

    Try
      StrInsCoverage:=InsCoverageArr[eInsCoverage.ItemIndex][0];
    Except
      on exception do
        StrInsCoverage:='';
    End;

    if (IntTotal=StrToInt(ToString(NilaiPolis.Text))) then begin
      if Main.OpenDb then begin
        Main.TransStart;
        If (VhcInsId='') then begin
          StrQry:='SELECT RIGHT(MAX(vhc_insurance_id),4) AS max_id FROM wh_vhc_insurance '+
                  'WHERE vhc_insurance_id  LIKE '+Chr(39)+'INS'+LocationCode+
                      FormatDateTime('yy',StrToDate(Main.Status.Panels.Items[0].Text))+
                      FormatDateTime('mm',StrToDate(Main.Status.Panels.Items[0].Text))+
                      '____'+Chr(39)+';';
          Qry.Close;
          Qry.SQL.Clear;
          Qry.SQL.Add(StrQry);
          Qry.Open;
          if Qry.FieldValues['max_id']<>NULL then
            StrMaxId:=Qry.FieldValues['max_id']
          else
            StrMaxId:='0000';
          StrMaxId:=Format('%.*d',[4, StrToInt(StrMaxId)+1]);

          StrMaxId:='INS'+LocationCode+FormatDateTime('yy',StrToDate(Main.Status.Panels.Items[0].Text))+
                    FormatDateTime('mm',StrToDate(Main.Status.Panels.Items[0].Text))+StrMaxId;

          StrDateFrom:=QuotedStr(FormatDateTime('yyyy-mm-dd', fromDate.Date));
          StrDateTo:=QuotedStr(FormatDateTime('yyyy-mm-dd', toDate.Date));

          Qry.Close;
          StrQry:='INSERT INTO wh_vhc_insurance '+
                  '(vhc_insurance_id, insurance_number, insurance_issuer_id, insurance_name_id, insurance_coverage_id, '+
                  ' insurance_from_date, insurance_to_date, insurance_amount,  update_user) '+
                  'VALUES ('+QuotedStr(StrMaxId)+','+QuotedStr(NoPolis.Text)+','+
                  QuotedStr(StrInsIssuer)+','+QuotedStr(StrInsName)+','+QuotedStr(StrInsCoverage)+','+
                  StrDateFrom+','+StrDateTo+','+QuotedStr(edt1.Text)+','+QuotedStr(User)+');';
          Qry.SQL.Clear;
          Qry.SQL.Add(StrQry);
          try
              Qry.ExecSQL;
          except on E:Exception do  begin
                IsOk:=False;
                StrEMsg:=E.Message;
              end
          end;
          StrQry := '';
          for IntCount:=0 to Length(VhcInsArr)-1 do begin
              StrQry:=StrQry +
                      'INSERT INTO wh_vhc_insurance_detail '+
                      '(vhc_insurance_id, vehicle_id, amount, update_user) '+
                      'VALUES ('+
                      QuotedStr(StrMaxId)+','+
                      QuotedStr(VhcInsArr[IntCount][0])+','+
                      QuotedStr(ToString(VhcInsArr[IntCount][2]))+','+
                      QuotedStr(User)+
                      '); ';
          end;

          Qry.Close;
          Qry.SQL.Clear;
          Qry.SQL.Add(StrQry);
          try
                Qry.ExecSQL;
          except
            on E:Exception do  begin
              IsOk:=False;
              StrEMsg:=E.Message;
            end
          end;

        end else begin
          StrVhcTransId := VhcInsId;
          StrDateFrom:=QuotedStr(FormatDateTime('yyyy-mm-dd', fromDate.Date));
          StrDateTo:=QuotedStr(FormatDateTime('yyyy-mm-dd', toDate.Date));

          Qry.Close;
          StrQry:='UPDATE wh_vhc_insurance SET '+
                  ' insurance_number='+QuotedStr(NoPolis.Text)+
                  ',insurance_issuer_id='+QuotedStr(StrInsIssuer)+
                  ',insurance_name_id='+QuotedStr(StrInsName)+
                  ',insurance_coverage_id='+QuotedStr(StrInsCoverage)+

                  ',insurance_from_date='+(StrDateFrom)+
                  ',insurance_to_date='+(StrDateTo)+
                  ',insurance_amount='+QuotedStr(ToString(NilaiPolis.Text))+
                  ',update_user='+QuotedStr(User)+
                  ' WHERE vhc_insurance_id='+QuotedStr(StrVhcTransId)+';';

          StrQry:=StrQry+'UPDATE wh_vhc_insurance_detail SET '+
                  ' status=0'+
                  ' WHERE vhc_insurance_id='+QuotedStr(StrVhcTransId)+';';

          Qry.SQL.Clear;
          Qry.SQL.Add(StrQry);
          try
              Qry.ExecSQL;
          except on E:Exception do  begin
                IsOk:=False;
                StrEMsg:=E.Message;
              end
          end;
          StrQry := '';
          for IntCount:=0 to Length(VhcInsArr)-1 do begin
              StrQry:=StrQry +
                      'INSERT INTO wh_vhc_insurance_detail '+
                      '(vhc_insurance_id, vehicle_id, amount, update_user) '+
                      'VALUES ('+
                      QuotedStr(StrVhcTransId)+','+
                      QuotedStr(VhcInsArr[IntCount][0])+','+
                      QuotedStr(ToString(VhcInsArr[IntCount][2]))+','+
                      QuotedStr(User)+
                      '); ';
          end;

          Qry.Close;
          Qry.SQL.Clear;
          Qry.SQL.Add(StrQry);
          try
                Qry.ExecSQL;
          except
            on E:Exception do  begin
              IsOk:=False;
              StrEMsg:=E.Message;
            end
          end;
        end;

        if IsOk then begin
          Main.TransCommit;
          MessageBox(0,'Berhasil menyimpan data', 'Asuransi Kendaraan',MB_OK or MB_ICONINFORMATION);
          Init;
          DisableInput;
        end else begin
          Main.TransRollback;
          StrEMsg:='Gagal Menyimpan Data'+Chr(13)+Chr(13)+'Kesalahan :'+Chr(13)+StrEMsg;
          MessageBox(0,PChar(StrEMsg),'Asuransi Kendaraan',MB_OK or MB_ICONERROR);
          EnableInput;
        end;
        FreeAndNil(Qry);
      end;
      Main.CloseDb;
    end else begin
      MessageBox(0,PChar('Nilai Pertanggungnya tidak sama !!!'),'Asuransi Kendaraan',MB_OK or MB_ICONERROR);
    end;
  end else begin
    MessageBox(Handle,PChar('Silahkan Lengkapi Kolom yang harus diisi'),'Asuransi Kendaraan',MB_OK or MB_ICONWARNING or MB_SYSTEMMODAL or MB_SETFOREGROUND);
  end;
end;

procedure TVehicleInsurance.NilaiPolisEnter(Sender: TObject);
begin
    NilaiPolis.Text:=ToString(NilaiPolis.Text);
end;

procedure TVehicleInsurance.NilaiPolisExit(Sender: TObject);
begin
  if ToString(NilaiPolis.Text)='' then NilaiPolis.Text:='0';
  if StrToFloat(NilaiPolis.Text)> 1000000000 then ribuan(NilaiPolis);
  NilaiPolis.Text:=SToCurr(NilaiPolis.Text);
end;

procedure TVehicleInsurance.NilaiPolisKeyPress(Sender: TObject;
  var Key: Char);
begin
  if Key=#13 then begin
    fromDate.SetFocus;
  end;
end;

procedure TVehicleInsurance.NoPolisKeyPress(Sender: TObject;
  var Key: Char);
begin
  if Key=#13 then begin
    eInsIssuer.SetFocus;
  end;
end;

procedure TVehicleInsurance.PenerbitPolisKeyPress(Sender: TObject;
  var Key: Char);
begin
  if Key=#13 then begin
    NilaiPolis.SetFocus;
  end;
end;

procedure TVehicleInsurance.HapusData1Click(Sender: TObject);
begin
    StrGridVhcList.DeleteRow(IntRowA);
    RefreshArray;
end;

end.
