    Provider = 'SQLOLEDB.1'
    Left = 40
    Top = 168
  end
  object qryComplainCust: TADOQuery
    Connection = con1
    CursorType = ctStatic
    Parameters = <>
    SQL.Strings = (
      
        'SELECT a.*,b.investigation,b.handling,b.renc_tindakan_perbaikan,' +
        ' b.investigation_date,'
      
        'b.handling_date,b.renc_tindakan_perbaikan_date, CONVERT(VARCHAR(' +
        '10), e.out_date,103) out_date,'
      
        'CONVERT(VARCHAR(10), c.update_time,103) complain_date,CONVERT(VA' +
        'RCHAR(10), '
      
        'b.investigation_date,103) analisa_date, CONVERT(VARCHAR(10), b.h' +
        'andling_date,103) perbaikan_date, '
      
        'CONVERT(VARCHAR(10), b.renc_tindakan_perbaikan_date,103) renc_ti' +
        'ndakan_perbaikan_date, '
      'd.name user_complain,f.name driver,g.license_plate,'
      
        'CONCAT(Substring(g.license_plate,1,1)+'#39' '#39'+Substring(g.license_pl' +
        'ate,2,4)+'#39' '
      
        #39'+Substring(g.license_plate,6,Len(g.license_plate)+1)+'#39#39','#39' / '#39',h' +
        '.name,'#39' '#39',i.seat,'#39' Seat'#39') armada '
      
        ', ( SELECT '#39'- '#39'+Description +CHAR(10) FROM wh_cust_complain_deta' +
        'il p2 WHERE p2.cust_complain_id = a.cust_complain_id and status=' +
        '1 ORDER BY cust_complain_detail_id FOR XML PATH('#39#39') )ComplainDet' +
        'ail'
      
        'FROM wh_cust_complain_ketidaksesuaian_perbaikan a LEFT JOIN wh_c' +
        'ust_complain_investigation b '
      
        'ON a.cust_complain_investigation_id=b.cust_complain_investigatio' +
        'n_id AND b.status=1 '
      
        'LEFT JOIN wh_cust_complain c ON b.cust_complain_id=c.cust_compla' +
        'in_id AND c.status=1 '
      
        'LEFT JOIN wh_user d ON c.update_user=d.username LEFT JOIN wh_vhc' +
        '_trans e'
      
        ' ON c.vhc_trans_id=e.vhc_trans_id LEFT JOIN wh_employee f ON e.e' +
        'mployee_id=f.employee_id '
      
        ' LEFT JOIN wh_vehicle g ON e.vehicle_id=g.vehicle_id LEFT JOIN w' +
        'h_vhc_batch h '
      
        ' ON g.vhc_batch_id=h.vhc_batch_id LEFT JOIN wh_vhc_type_detail i' +
        ' '
      ' ON g.vhc_type_detail_id=i.vhc_type_detail_id WHERE a.status=1 '
      ' AND a.no_ketidaksesuaian_perbaikan='#39'KP/WHJKT/MK/2407001'#39'; ')
    Left = 104
    Top = 31
  end
